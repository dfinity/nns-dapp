#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

# shellcheck disable=SC2317,SC2329
print_help() {
  cat <<-EOF

	Tests that the aggregator canister config is set to the expected value after deploying.
	EOF
}
# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/../../clap.bash"
# Define options
clap.define short=n long=network desc="The icp network to use" variable=DFX_NETWORK default="local"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"
EXIT=0

# The network and the environment have the same name, see icp.yaml.
ENVIRONMENT="$DFX_NETWORK"

check() {
  sleep 2
  ACTUAL_CONFIG="$(icp canister call sns_aggregator get_canister_config '()' --environment "$ENVIRONMENT" --query)"
  DIFF="$(diff <(echo "($EXPECTED_CONFIG)" | idl2json | jq .) <(echo "$ACTUAL_CONFIG" | idl2json | jq .) || true)"
  test -z "${DIFF:-}" || {
    "$SOURCE_DIR/get_log" --network "$DFX_NETWORK"
    echo
    printf "ERROR: %s\n" "Deployed config is not as expected." "Expected:" "$EXPECTED_CONFIG" "Actual:" "$ACTUAL_CONFIG" "Diff:" "$DIFF"
    exit 1
  }
  echo "Check passes"
}

# Installs a wasm. A failed installation stops the script.
install_aggregator() {
  icp canister install sns_aggregator --yes --environment "$ENVIRONMENT" "$@" || {
    echo "ERROR: Could not install the aggregator with: $*"
    exit 1
  } >&2
}

# Runs a check that is expected to fail, until the bug that it covers is fixed.
#
# Arguments: <TODO message>
expect_check_to_fail() {
  if (check); then
    echo "ERROR: You forgot to enable the test after fixing the bug."
    exit 1
  fi >&2
  echo "TODO: $1"
}

printf "\n\n\n=========================================\n"
echo "Checking direct reinstallation"
EXPECTED_CONFIG='record { update_interval_ms = 1345; fast_interval_ms = 1_123_456_789; }'
install_aggregator --wasm ./sns_aggregator.wasm.gz --mode reinstall --args "$(didc encode "( opt $EXPECTED_CONFIG)")" --args-format hex
expect_check_to_fail 'The argument is not provided to init(...).  Find out why and fix.'

printf "\n\n\n=========================================\n"
echo "Checking upgrade with a raw argument"
EXPECTED_CONFIG='record { update_interval_ms = 1366; fast_interval_ms = 1_123_456_789; }'
install_aggregator --wasm ./sns_aggregator.wasm.gz --mode upgrade --args "$(didc encode "( opt $EXPECTED_CONFIG)")" --args-format hex
expect_check_to_fail 'The argument is not provided to init(...).  Find out why and fix.'

printf "\n\n\n=========================================\n"
echo "Checking upgrade with a candid argument"
EXPECTED_CONFIG='record { update_interval_ms = 3233; fast_interval_ms = 1_123_456_789; }'
install_aggregator --wasm ./sns_aggregator.wasm.gz --mode upgrade --args "( opt $EXPECTED_CONFIG)"
expect_check_to_fail 'The argument is not provided to post_install(...).  Find out why and fix.'

(
  printf "\n\n\n=========================================\n"
  echo "Checking reconfiguring - present only for dev builds"
  EXPECTED_CONFIG='record { update_interval_ms = 9834; fast_interval_ms = 1_123_456_789; }'
  test -f sns_aggregator_dev.wasm.gz || cp out/sns_aggregator_dev.wasm.gz ./sns_aggregator_dev.wasm.gz
  install_aggregator --wasm ./sns_aggregator_dev.wasm.gz --mode upgrade
  icp canister call sns_aggregator reconfigure "( opt $EXPECTED_CONFIG)" --environment "$ENVIRONMENT"
  check
) || EXIT=1

echo 'TODO : Test deploying by proposal'

printf "\n\n\n=========================================\n"
if (("$EXIT" == 0)); then
  echo ALL AGGREGATOR CONFIG TESTS PASSED
else
  echo SOME AGGREGATOR CONFIG TESTS FAILED
fi
exit "${EXIT}"
